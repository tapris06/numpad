config_version=5

[application]
config/name="Numpad Nine"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://content/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=1000
window/size/min_height=625
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[dotnet]
project/assembly_name="NumpadNine"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.985, 0.98, 0.965, 1)

[audio]
driver/output_latency=20
